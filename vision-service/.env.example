# Vision Inference Service Configuration

# Server settings
HOST=0.0.0.0
PORT=8100

# ONNX Runtime execution providers (comma-separated)
# Options: MIGraphXExecutionProvider, CUDAExecutionProvider, CPUExecutionProvider
#
# For AMD GPU (ROCm 7.1+): MIGraphXExecutionProvider
#   Note: ROCMExecutionProvider was deprecated in ROCm 7.1+
#   Requires: onnxruntime-migraphx package and LD_LIBRARY_PATH=/opt/rocm/lib
#   Use the provided run.sh script or set LD_LIBRARY_PATH manually
#
# For NVIDIA GPU: CUDAExecutionProvider,CPUExecutionProvider
# For CPU only: CPUExecutionProvider
ONNX_PROVIDERS=MIGraphXExecutionProvider

# InsightFace model name
# buffalo_l: Large model, 512-dim embeddings, best accuracy
# buffalo_s: Small model, faster but less accurate
INSIGHTFACE_MODEL=buffalo_l

# Detection input size (larger = more accurate but slower)
DET_SIZE=640

# The selected NudeNet 3.4.2 model is lazy-loaded on the first nudity request.
# MIGraphX must be active by default. CPU stays in the session provider list for
# ONNX node fallback, but a CPU-only session is rejected unless REQUIRE_GPU=false.
# 640m must be provisioned at MODEL_CACHE_DIR/nudenet/640m.onnx with the pinned hash.
NUDITY_ENABLED=true
NUDITY_MODEL=640m
NUDITY_ONNX_PROVIDERS=MIGraphXExecutionProvider,CPUExecutionProvider
NUDITY_REQUIRE_GPU=true
NUDITY_INITIALIZATION_RETRY_SECONDS=60

# Request and inference admission limits
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
MAX_BATCH_ITEMS=16
MAX_BATCH_BYTES=33554432
MAX_CONCURRENT_INFERENCES=1
INFERENCE_ACQUIRE_TIMEOUT_SECONDS=0.1

# Optional backend-to-service authentication. Leave empty to keep it disabled.
# INTERNAL_API_SECRET=replace-with-a-long-random-secret

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Model cache directory
MODEL_CACHE_DIR=./models
