{
  "name": "video-streaming-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "test": "bun run test:unit",
    "test:unit": "bun scripts/run-test-files.ts --unit",
    "test:integration": "bun scripts/run-test-files.ts --integration",
    "test:files": "bun scripts/run-test-files.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --sourcemap=external",
    "posthog:sourcemaps": "bun scripts/publish-posthog-sourcemaps.ts",
    "start:prod": "NODE_ENV=production NODE_OPTIONS='--enable-source-maps' bun dist/index.js",
    "prestart:prod": "bun run validate:env && bun run check:deps && bun run db:migrate",
    "validate:env": "bun scripts/validate-env.ts",
    "check:deps": "bun scripts/check-dependencies.ts",
    "demo:download": "bun scripts/download-demo-media.ts && bun scripts/generate-demo-artwork.ts",
    "demo:artwork": "bun scripts/generate-demo-artwork.ts",
    "demo:previews": "bun scripts/generate-demo-previews.ts",
    "demo:import-json": "bun run demo:migrate-json",
    "demo:seed": "bun scripts/seed-demo-database.ts",
    "demo:migrate-json": "bun scripts/import-demo-json-to-sqlite.ts",
    "demo:reset": "bun scripts/reset-demo-database.ts",
    "demo:db:generate": "drizzle-kit generate --config drizzle.demo.config.ts",
    "demo:db:migrate": "drizzle-kit migrate --config drizzle.demo.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:introspect": "drizzle-kit introspect"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "~1.6.33",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.3",
    "@napi-rs/canvas": "^1.0.10",
    "@node-rs/xxhash": "^1.7.8",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "bcrypt": "^6.0.0",
    "better-auth": "~1.6.33",
    "chokidar": "^5.0.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^6.1.0",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "posthog-node": "^5.55.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@posthog/cli": "^0.10.0",
    "@types/bcrypt": "^6.0.0",
    "bun-types": "~1.3.14",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "trustedDependencies": [
    "@posthog/cli"
  ],
  "overrides": {
    "esbuild": "^0.25.12"
  }
}
