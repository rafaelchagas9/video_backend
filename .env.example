# Server
PORT=3000
HOST=localhost
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
BASE_URL=http://localhost:3000

# Demo mode (isolated SQLite database and media root)
DEMO_MODE=false
DEMO_DATABASE_PATH=./demo_mode/demo.sqlite
DEMO_ASSETS_DIR=./demo_mode
# on-start restores seeded mutable state; manual persists changes across restarts.
DEMO_RESET_MODE=on-start

# PostgreSQL Database (recommended)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=video_streaming_db
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_MAX_CONNECTIONS=20

# Paths
THUMBNAILS_DIR=./data/thumbnails
ARTWORK_DIR=./data/artwork
# Title treatments. Must match the display pairing the clients ship.
ARTWORK_TITLE_FONT_PATH=./assets/fonts/Figtree-Display.ttf
ARTWORK_TITLE_FONT_FAMILY=Figtree
ARTWORK_TITLE_FALLBACK_FONT_PATH=./assets/fonts/Archivo-Regular.ttf
ARTWORK_TITLE_FALLBACK_FONT_FAMILY=Archivo
PROFILE_PICTURES_DIR=./data/profile-pictures
FACES_DIR=./data/faces
LOGS_DIR=./logs

# Authentication
SESSION_SECRET=change-this-to-a-random-secret-in-production
SESSION_EXPIRY_HOURS=168

# Video Processing
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
THUMBNAIL_SIZE=320x180
THUMBNAIL_TIMESTAMP=5.0
THUMBNAIL_FORMAT=webp
THUMBNAIL_QUALITY=75
THUMBNAIL_POSITION_PERCENT=20
ARTWORK_QUALITY=84
PROFILE_PICTURE_MAX_SIZE=1080
PROFILE_PICTURE_FORMAT=webp
PROFILE_PICTURE_QUALITY=80
IMAGE_DOWNLOAD_MIN_INTERVAL_MS=1000
FACE_THUMBNAIL_SIZE=320
FACE_THUMBNAIL_FORMAT=webp
FACE_THUMBNAIL_QUALITY=80
FACE_IMAGE_PADDING=0.5

# Storyboards (Vidstack slider thumbnails)
STORYBOARDS_DIR=./data/storyboards
STORYBOARD_TILE_WIDTH=192
STORYBOARD_TILE_HEIGHT=108
STORYBOARD_INTERVAL_SECONDS=6
STORYBOARD_FORMAT=webp
STORYBOARD_QUALITY=70
STORYBOARD_RAM_COPY_MAX_MB=512
STORYBOARD_MAX_TILES=300
STORYBOARD_READAHEAD_MAX_MB=1024
STORYBOARD_MAX_CONCURRENT=1

# File Scanning
DEFAULT_SCAN_INTERVAL_MINUTES=30
MAX_FILE_SIZE_GB=50

# Video Conversion (GPU Acceleration)
VAAPI_DEVICE=/dev/dri/renderD128
CONVERTED_VIDEOS_DIR=./data/converted
CONVERSION_MAX_CONCURRENT=1
STREAM_MAX_CHUNK_MB=8
# Ephemeral HLS sessions used by Google Cast. Point this at an SSD if desired.
CAST_TRANSCODE_DIR=./data/cast-transcodes
# Delete a session after this many minutes without manifest, segment, or status access.
CAST_SESSION_IDLE_TTL_MINUTES=10
CAST_SESSION_CLEANUP_INTERVAL_SECONDS=60
# Publish an updating EVENT playlist after this much media exists beyond the
# requested Cast start position. The transcode continues while the TV plays.
CAST_HLS_STARTUP_BUFFER_SECONDS=16

# Performance profiling
PERF_PROFILING_ENABLED=false
PERF_PROFILING_LOG_PATH=./logs/performance-profile.jsonl

# Telemetry
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_LOG_LEVEL=warn
POSTHOG_CAPTURE_REQUEST_METRICS=true

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# Face Recognition
FACE_SERVICE_URL=http://localhost:8100
FACE_SIMILARITY_THRESHOLD=0.65
FACE_AUTO_TAG_THRESHOLD=0.75
FACE_DETECTION_BATCH_SIZE=10
FACE_DETECTION_RETRY_INTERVAL_MS=300000
FACE_DETECTION_MAX_RETRIES=3
FACE_EXTRACTION_INTERVAL_SECONDS=8
FACE_EXTRACTION_MAX_WIDTH=960
FACE_EXTRACTION_FORMAT=jpg
FACE_EXTRACTION_QUALITY=75

# Frame Extraction (unified frame extraction for thumbnails, storyboards, and faces)
FRAME_EXTRACTION_TEMP_DIR=/dev/shm
FRAME_EXTRACTION_FORMAT=jpg
FRAME_EXTRACTION_QUALITY=90

# LLM (Ollama) - for AI-powered title generation
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3n:e2b
OLLAMA_TIMEOUT_MS=60000
