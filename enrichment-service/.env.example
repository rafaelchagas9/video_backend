# Creator Enrichment Service Configuration

# Server settings (used later when the FastAPI service is built)
HOST=0.0.0.0
PORT=8200

# --- Metadata databases (both implement the StashBox GraphQL schema) ---
# ThePornDB: register at https://theporndb.net -> User -> API Token.
# Name search uses GraphQL. Exact URL/slug/numeric ID/UUID lookup uses REST.
THEPORNDB_API_KEY=
THEPORNDB_BASE_URL=https://theporndb.net/graphql
THEPORNDB_REST_URL=https://api.theporndb.net

# StashDB: account -> Settings -> API Key
STASHDB_API_KEY=
STASHDB_ENDPOINT=https://stashdb.org/graphql

# Per-source enable flags (a source also requires its API key to be active)
ENABLE_THEPORNDB=true
ENABLE_STASHDB=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# NOTE: For local exploration the script also falls back to reading the keys
# from the repository root .env (../.env) if they are not set here.

# FansDB invitation credentials, when available
FANSDB_API_KEY=
FANSDB_ENDPOINT=https://fansdb.cc/graphql
ENABLE_FANSDB=false
# Optional local Stash GraphQL bridge. Install community scrapers in its UI.
STASH_ENDPOINT=http://127.0.0.1:9999/graphql
STASH_API_KEY=
ENABLE_STASH=false
# UI provider changes are stored privately here (secrets are never returned).
# PROVIDER_CONFIG_PATH=./data/providers.json

# HTTP pooling: connect/pool limits stay short; batch reads retain >=120 seconds.
REQUEST_TIMEOUT_SECONDS=30
CONNECT_TIMEOUT_SECONDS=5
POOL_TIMEOUT_SECONDS=5
# Routine access logs are off; application warnings/errors remain enabled.
ACCESS_LOG=false
